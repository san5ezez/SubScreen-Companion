<UserControl x:Class="SubScreenCompanion.Views.PortraitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SubScreenCompanion.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="1920" d:DesignWidth="480">

    <Grid Background="{Binding CurrentPreset.BackgroundBrush}">
        <!-- Главная вертикальная раскладка виджетов -->
        <Grid Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <!-- 1. Часы и статус -->
                <RowDefinition Height="Auto"/>
                <!-- 2. CPU -->
                <RowDefinition Height="Auto"/>
                <!-- 3. GPU -->
                <RowDefinition Height="Auto"/>
                <!-- 4. RAM -->
                <RowDefinition Height="Auto"/>
                <!-- 5. Сеть -->
                <RowDefinition Height="Auto"/>
                <!-- 6. Диск / Статус -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Часы и дата -->
            <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="16" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1.5"
                    Padding="16,18">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CurrentPreset.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM TIME" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TimeString}" FontSize="50" FontWeight="Black" 
                               Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DateString}" FontSize="13" FontWeight="SemiBold" 
                               Foreground="{Binding CurrentPreset.SubtextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. CPU Карточка -->
            <Border Grid.Row="1" Margin="0,0,0,12" CornerRadius="16" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1.5"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок CPU -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CurrentPreset.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="CPU" FontSize="13" FontWeight="Black" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CpuName}" FontSize="13" FontWeight="Bold" 
                                   Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Right" 
                                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Датчики CPU -->
                    <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Center" Margin="0,4,0,10">
                        <controls:CircularGauge Value="{Binding CpuLoad}" Maximum="100" 
                                                Title="LOAD" Suffix="%"
                                                Stroke="{Binding CurrentPreset.AccentBrush}"
                                                TrackStroke="{Binding CurrentPreset.GaugeTrackBrush}"
                                                Margin="6"/>
                        <controls:CircularGauge Value="{Binding CpuTemp}" Maximum="105" 
                                                Title="TEMP" Suffix="°C"
                                                Stroke="{Binding CurrentPreset.SecondaryAccentBrush}"
                                                TrackStroke="{Binding CurrentPreset.GaugeTrackBrush}"
                                                Margin="6"/>
                    </UniformGrid>

                    <!-- Частота и питание -->
                    <Grid Grid.Row="2" Margin="4,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FREQUENCY" FontSize="9" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                            <TextBlock Text="{Binding CpuClock, StringFormat={}{0:F0} MHz}" FontSize="14" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="PACKAGE POWER" FontSize="9" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CpuPower, StringFormat={}{0:F0} W}" FontSize="14" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. GPU Карточка -->
            <Border Grid.Row="2" Margin="0,0,0,12" CornerRadius="16" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1.5"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок GPU -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CurrentPreset.SecondaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="GPU" FontSize="13" FontWeight="Black" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding GpuName}" FontSize="13" FontWeight="Bold" 
                                   Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Right" 
                                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Датчики GPU -->
                    <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Center" Margin="0,4,0,10">
                        <controls:CircularGauge Value="{Binding GpuLoad}" Maximum="100" 
                                                Title="LOAD" Suffix="%"
                                                Stroke="{Binding CurrentPreset.SecondaryAccentBrush}"
                                                TrackStroke="{Binding CurrentPreset.GaugeTrackBrush}"
                                                Margin="6"/>
                        <controls:CircularGauge Value="{Binding GpuTemp}" Maximum="100" 
                                                Title="TEMP" Suffix="°C"
                                                Stroke="{Binding CurrentPreset.AccentBrush}"
                                                TrackStroke="{Binding CurrentPreset.GaugeTrackBrush}"
                                                Margin="6"/>
                    </UniformGrid>

                    <!-- VRAM -->
                    <StackPanel Grid.Row="2" Margin="4,0,4,0">
                        <DockPanel>
                            <TextBlock Text="VRAM USAGE" FontSize="9" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                            <TextBlock Text="{Binding GpuMemoryUsed, StringFormat={}{0:F1} GB}" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar Height="8" Maximum="100" Value="{Binding GpuMemoryPercent}" 
                                     Foreground="{Binding CurrentPreset.SecondaryAccentBrush}" 
                                     Background="{Binding CurrentPreset.GaugeTrackBrush}" 
                                     BorderThickness="0" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. RAM Карточка -->
            <Border Grid.Row="3" Margin="0,0,0,12" CornerRadius="16" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1.5"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CurrentPreset.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="RAM" FontSize="13" FontWeight="Black" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Right">
                            <Run Text="{Binding RamUsedGb, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding RamTotalGb, Mode=OneWay}"/>
                            <Run Text=" GB"/>
                        </TextBlock>
                    </Grid>

                    <ProgressBar Height="10" Maximum="100" Value="{Binding RamLoad}" 
                                 Foreground="{Binding CurrentPreset.AccentBrush}" 
                                 Background="{Binding CurrentPreset.GaugeTrackBrush}" 
                                 BorderThickness="0" Margin="0,4,0,0"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="UTILIZATION" FontSize="9" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                        <TextBlock Text="{Binding RamLoad, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Bold" 
                                   Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 5. Сеть Карточка -->
            <Border Grid.Row="4" Margin="0,0,0,12" CornerRadius="16" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1.5"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,6,0" Background="{Binding CurrentPreset.GaugeTrackBrush}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="▼ DOWNLOAD" FontSize="9" FontWeight="Black" Foreground="{Binding CurrentPreset.AccentBrush}"/>
                            <TextBlock Text="{Binding NetDownSpeed}" FontSize="16" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="6,0,0,0" Background="{Binding CurrentPreset.GaugeTrackBrush}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="▲ UPLOAD" FontSize="9" FontWeight="Black" Foreground="{Binding CurrentPreset.SecondaryAccentBrush}"/>
                            <TextBlock Text="{Binding NetUpSpeed}" FontSize="16" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 6. SSD Накопитель & Нижний статус -->
            <Border Grid.Row="5" CornerRadius="16" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1.5"
                    Padding="16,14" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CurrentPreset.SecondaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="STORAGE SSD" FontSize="11" FontWeight="Black" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding DiskLoad, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Height="6" Maximum="100" Value="{Binding DiskLoad}" 
                                 Foreground="{Binding CurrentPreset.SecondaryAccentBrush}" 
                                 Background="{Binding CurrentPreset.GaugeTrackBrush}" 
                                 BorderThickness="0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
