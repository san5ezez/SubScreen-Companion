<UserControl x:Class="SubScreenCompanion.Views.LandscapeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SubScreenCompanion.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="1920">

    <Grid Background="{Binding CurrentPreset.BackgroundBrush}">
        <!-- Главная горизонтальная раскладка виджетов -->
        <Grid Margin="18,12,18,12">
            <Grid.ColumnDefinitions>
                <!-- Часы и дата -->
                <ColumnDefinition Width="1.1*" />
                <!-- CPU -->
                <ColumnDefinition Width="1.4*" />
                <!-- GPU -->
                <ColumnDefinition Width="1.4*" />
                <!-- RAM & Сеть -->
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Часы и системная дата -->
            <Border Grid.Column="0" Margin="6" CornerRadius="14" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CurrentPreset.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM TIME" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TimeString}" FontSize="46" FontWeight="Black" 
                                   Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DateString}" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{Binding CurrentPreset.SubtextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{Binding CurrentPreset.GaugeTrackBrush}" CornerRadius="8" Padding="10,6">
                        <TextBlock Text="SUBSCREEN MONITOR" FontSize="10" FontWeight="Bold" 
                                   Foreground="{Binding CurrentPreset.AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. CPU Блок -->
            <Border Grid.Column="1" Margin="6" CornerRadius="14" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок CPU -->
                    <DockPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CurrentPreset.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="PROCESSOR" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CpuName}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{Binding CurrentPreset.TextBrush}" DockPanel.Dock="Right" 
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    </DockPanel>

                    <!-- Два датчика CPU: Load и Temp -->
                    <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Center">
                        <controls:CircularGauge Value="{Binding CpuLoad}" Maximum="100" 
                                                Title="LOAD" Suffix="%"
                                                Stroke="{Binding CurrentPreset.AccentBrush}"
                                                TrackStroke="{Binding CurrentPreset.GaugeTrackBrush}"
                                                Margin="4"/>
                        <controls:CircularGauge Value="{Binding CpuTemp}" Maximum="105" 
                                                Title="TEMP" Suffix="°C"
                                                Stroke="{Binding CurrentPreset.SecondaryAccentBrush}"
                                                TrackStroke="{Binding CurrentPreset.GaugeTrackBrush}"
                                                Margin="4"/>
                    </UniformGrid>

                    <!-- Дополнительная инфо (Частота и Мощность) -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CLOCK" FontSize="9" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                            <TextBlock Text="{Binding CpuClock, StringFormat={}{0:F0} MHz}" FontSize="13" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="POWER" FontSize="9" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CpuPower, StringFormat={}{0:F0} W}" FontSize="13" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. GPU Блок -->
            <Border Grid.Column="2" Margin="6" CornerRadius="14" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок GPU -->
                    <DockPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CurrentPreset.SecondaryAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="GRAPHICS" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GpuName}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{Binding CurrentPreset.TextBrush}" DockPanel.Dock="Right" 
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    </DockPanel>

                    <!-- Два датчика GPU: Load и Temp -->
                    <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Center">
                        <controls:CircularGauge Value="{Binding GpuLoad}" Maximum="100" 
                                                Title="LOAD" Suffix="%"
                                                Stroke="{Binding CurrentPreset.SecondaryAccentBrush}"
                                                TrackStroke="{Binding CurrentPreset.GaugeTrackBrush}"
                                                Margin="4"/>
                        <controls:CircularGauge Value="{Binding GpuTemp}" Maximum="100" 
                                                Title="TEMP" Suffix="°C"
                                                Stroke="{Binding CurrentPreset.AccentBrush}"
                                                TrackStroke="{Binding CurrentPreset.GaugeTrackBrush}"
                                                Margin="4"/>
                    </UniformGrid>

                    <!-- Полоса VRAM -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Text="VRAM USAGE" FontSize="9" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                            <TextBlock Text="{Binding GpuMemoryUsed, StringFormat={}{0:F1} GB}" FontSize="10" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar Height="6" Maximum="100" Value="{Binding GpuMemoryPercent}" 
                                     Foreground="{Binding CurrentPreset.SecondaryAccentBrush}" 
                                     Background="{Binding CurrentPreset.GaugeTrackBrush}" 
                                     BorderThickness="0" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. RAM и Сеть Блок -->
            <Border Grid.Column="3" Margin="6" CornerRadius="14" 
                    Background="{Binding CurrentPreset.CardBrush}" 
                    BorderBrush="{Binding CurrentPreset.CardBorderBrush}" BorderThickness="1">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- RAM Секция -->
                    <StackPanel Grid.Row="0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CurrentPreset.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="MEMORY (RAM)" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                            </StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Right">
                                <Run Text="{Binding RamUsedGb, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding RamTotalGb, Mode=OneWay}"/>
                                <Run Text=" GB"/>
                            </TextBlock>
                        </DockPanel>

                        <ProgressBar Height="10" Maximum="100" Value="{Binding RamLoad}" 
                                     Foreground="{Binding CurrentPreset.AccentBrush}" 
                                     Background="{Binding CurrentPreset.GaugeTrackBrush}" 
                                     BorderThickness="0" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RamLoad, StringFormat={}{0:F0}% Использовано}" FontSize="10" 
                                   Foreground="{Binding CurrentPreset.SubtextBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Сеть Секция (Download / Upload) -->
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Download -->
                        <Border Grid.Column="0" Margin="0,0,4,0" Background="{Binding CurrentPreset.GaugeTrackBrush}" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="▼ DOWNLOAD" FontSize="9" FontWeight="Black" Foreground="{Binding CurrentPreset.AccentBrush}"/>
                                <TextBlock Text="{Binding NetDownSpeed}" FontSize="14" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Upload -->
                        <Border Grid.Column="1" Margin="4,0,0,0" Background="{Binding CurrentPreset.GaugeTrackBrush}" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="▲ UPLOAD" FontSize="9" FontWeight="Black" Foreground="{Binding CurrentPreset.SecondaryAccentBrush}"/>
                                <TextBlock Text="{Binding NetUpSpeed}" FontSize="14" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Диск / Хранилище -->
                    <Grid Grid.Row="2">
                        <DockPanel>
                            <TextBlock Text="STORAGE SSD/HDD" FontSize="9" FontWeight="Bold" Foreground="{Binding CurrentPreset.SubtextBrush}"/>
                            <TextBlock Text="{Binding DiskLoad, StringFormat={}{0:F0}%}" FontSize="10" FontWeight="Bold" Foreground="{Binding CurrentPreset.TextBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar Height="4" Maximum="100" Value="{Binding DiskLoad}" 
                                     Foreground="{Binding CurrentPreset.AccentBrush}" 
                                     Background="{Binding CurrentPreset.GaugeTrackBrush}" 
                                     BorderThickness="0" Margin="0,3,0,0" VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>

