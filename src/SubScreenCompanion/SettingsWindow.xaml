<Window x:Class="SubScreenCompanion.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SubScreen Companion — Настройки"
        Height="680" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#0E121A" Foreground="#E2E8F0"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Стили для красивого интерфейса настроек -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#232C3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#171F2C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D3A50"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Контент с прокруткой -->
            <RowDefinition Height="*"/>
            <!-- Кнопки внизу -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="12" Height="12" CornerRadius="6" Background="#00F0FF" Margin="0,0,12,0"/>
                <TextBlock Text="SubScreen Companion" FontSize="20" FontWeight="Black" Foreground="#FFFFFF"/>
                <Border Background="#1C2638" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="JONSBO D31/D41 Edition" FontSize="11" FontWeight="Bold" Foreground="#00F0FF"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Настройки и пресеты" FontSize="13" Foreground="#7A8B9E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- Основной контент с настройками -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>

                <!-- 1. Пресеты оформления -->
                <GroupBox Header="1. ВИЗУАЛЬНЫЕ ПРЕСЕТЫ">
                    <StackPanel>
                        <TextBlock Text="Выберите стиль отображения для экрана в корпусе:" FontSize="12" Foreground="#8A99AD" Margin="0,0,0,12"/>
                        
                        <WrapPanel x:Name="PresetsPanel" Margin="0,0,0,6">
                            <!-- Пресет: Cyberpunk -->
                            <RadioButton x:Name="RbPresetCyberpunk" GroupName="PresetGroup" Checked="OnPresetSelected" Tag="Cyberpunk" Margin="0,0,12,12">
                                <Border Background="#121824" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="10" Width="200" Padding="12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="⚡ Cyberpunk" FontWeight="Bold" Foreground="#00F0FF"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="#FF007F" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="Неон циан + пурпур, глубокий контраст" FontSize="10" Foreground="#8293A6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- Пресет: Stealth Dark -->
                            <RadioButton x:Name="RbPresetStealth" GroupName="PresetGroup" Checked="OnPresetSelected" Tag="Stealth" Margin="0,0,12,12">
                                <Border Background="#18181C" BorderBrush="#3A3A45" BorderThickness="1.5" CornerRadius="10" Width="200" Padding="12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="⬛ Stealth Dark" FontWeight="Bold" Foreground="#E6EDF3"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="#A4B1C2" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="Строгий графитовый минимализм" FontSize="10" Foreground="#8293A6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- Пресет: Gaming Red -->
                            <RadioButton x:Name="RbPresetGamingRed" GroupName="PresetGroup" Checked="OnPresetSelected" Tag="GamingRed" Margin="0,0,12,12">
                                <Border Background="#1C090D" BorderBrush="#FF2A4D" BorderThickness="1.5" CornerRadius="10" Width="200" Padding="12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="🔥 Gaming Red" FontWeight="Bold" Foreground="#FF2A4D"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="#FF7B00" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="Черно-красный стиль геймерской сборки" FontSize="10" Foreground="#A8606B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- Пресет: Snow White -->
                            <RadioButton x:Name="RbPresetWhiteSnow" GroupName="PresetGroup" Checked="OnPresetSelected" Tag="WhiteSnow" Margin="0,0,12,12">
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Width="200" Padding="12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="❄️ Snow White" FontWeight="Bold" Foreground="#0F172A"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="#2563EB" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="Для белых сборок (Jonsbo D31 White)" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <!-- Пресет: Amber Synthwave -->
                            <RadioButton x:Name="RbPresetAmberRetro" GroupName="PresetGroup" Checked="OnPresetSelected" Tag="AmberRetro" Margin="0,0,12,12">
                                <Border Background="#20150A" BorderBrush="#FF9E1B" BorderThickness="1.5" CornerRadius="10" Width="200" Padding="12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="☀️ Amber Sci-Fi" FontWeight="Bold" Foreground="#FF9E1B"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="#FFD000" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="Теплый янтарный терминал" FontSize="10" Foreground="#A87E4B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Выбор экрана и ориентация -->
                <GroupBox Header="2. ЭКРАН И ОРИЕНТАЦИЯ">
                    <StackPanel>
                        <TextBlock Text="Выберите монитор, установленный в корпусе:" FontSize="12" Foreground="#8A99AD" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button Content="🔄 Обновить" Click="OnRefreshScreensClick" Width="100" Margin="10,0,0,0" DockPanel.Dock="Right" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155"/>
                            <ComboBox x:Name="CbScreens" SelectionChanged="OnScreenSelectionChanged"/>
                        </DockPanel>

                        <TextBlock Text="Ориентация экрана:" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,4,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="RbOrientAuto" Content="⚡ Автоопределение (по размеру)" IsChecked="True"/>
                            <RadioButton x:Name="RbOrientLandscape" Content="Горизонтальная (Landscape)"/>
                            <RadioButton x:Name="RbOrientPortrait" Content="Вертикальная (Portrait)"/>
                        </StackPanel>
                        <TextBlock Text="* В авторежиме приложение само поймет горизонтальное или вертикальное положение экрана по разрешению." FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Блокировка курсора мыши -->
                <GroupBox Header="3. ЗАЩИТА ОТ МЫШИ (MOUSE BARRIER)">
                    <StackPanel>
                        <CheckBox x:Name="ChkMouseBarrier" Content="🔒 Блокировать курсор мыши на этом экране (не давать мыши заехать в корпус)" FontWeight="Bold" Foreground="#00F0FF"/>
                        <TextBlock Text="Предотвращает случайную потерю курсора в корпусе ПК. Курсор упирается в границу основного экрана." FontSize="11" Foreground="#8A99AD" Margin="24,2,0,8"/>

                        <Border Background="#141E2C" CornerRadius="8" Padding="12,10" Margin="0,6,0,0">
                            <DockPanel>
                                <TextBlock Text="Горячая клавиша быстрой разблокировки:" VerticalAlignment="Center" FontSize="12" Foreground="#CBD5E1"/>
                                <Border Background="#1F2E45" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                    <TextBlock Text="Ctrl + Alt + M" FontWeight="Bold" Foreground="#00F0FF" FontSize="12"/>
                                </Border>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 4. Автозапуск и поведение окон -->
                <GroupBox Header="4. АВТОЗАПУСК И СИСТЕМА">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutostart" Content="🚀 Запускать приложение автоматически при входе в Windows"/>
                        <CheckBox x:Name="ChkTopmost" Content="📌 Держать окно поверх всех остальных окон (Always on Top)"/>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Интервал обновления датчиков:" VerticalAlignment="Center" FontSize="12" Foreground="#8A99AD"/>
                            <ComboBox x:Name="CbRefreshInterval" Width="140" HorizontalAlignment="Right">
                                <ComboBoxItem Content="500 мс (быстро)" Tag="500"/>
                                <ComboBoxItem Content="1000 мс (нормально)" Tag="1000" IsSelected="True"/>
                                <ComboBoxItem Content="2000 мс (экономно)" Tag="2000"/>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки внизу -->
        <Border Grid.Row="2" Background="#121824" CornerRadius="12" Padding="16" BorderBrush="#1F2A3D" BorderThickness="1">
            <DockPanel>
                <Button Content="Скрыть в трей" Click="OnHideClick" Width="130" Height="36" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" DockPanel.Dock="Left"/>
                <Button Content="💾 Сохранить и применить" Click="OnSaveClick" Width="200" Height="36" Background="#00F0FF" Foreground="#090C12" FontWeight="Black" BorderThickness="0" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
