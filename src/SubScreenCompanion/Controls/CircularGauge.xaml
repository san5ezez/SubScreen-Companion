<UserControl x:Class="SubScreenCompanion.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="120">
    <Grid>
        <Canvas x:Name="GaugeCanvas" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Фоновая окружность-дорожка -->
            <Path x:Name="TrackPath" StrokeThickness="8" Stroke="#202938" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <!-- Активная дуга прогресса -->
            <Path x:Name="ProgressPath" StrokeThickness="8" Stroke="#00F0FF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>

        <!-- Центральный текст -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TxtValue" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtTitle" Text="LOAD" FontSize="10" FontWeight="SemiBold" Foreground="#7E8B9B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
